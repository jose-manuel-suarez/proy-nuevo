# Copy to .env and fill in real values for local development.
# Never commit the resulting .env file.

# --- Database ---------------------------------------------------------------
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-local-db-password
# Consumed by the backend and by Alembic. Host is the Compose service name.
DATABASE_URL=postgresql+asyncpg://app:change-me-local-db-password@postgres:5432/app

# --- Backend ----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Shared secret presented by the frontend on every API call.
SERVICE_TOKEN=change-me-local-service-token
# Base URL the frontend uses to reach the backend inside the container network.
BACKEND_URL=http://backend:8000
# Upstream timeout in seconds.
REQUEST_TIMEOUT=5

# --- Frontend ---------------------------------------------------------------
# Flask session signing key.
SECRET_KEY=change-me-local-session-secret

# --- Edge proxy -------------------------------------------------------------
# Local development serves plain HTTP on this hostname.
DOMAIN=localhost

# --- Release metadata (production only) -------------------------------------
GHCR_OWNER=your-github-user
GHCR_REPO=your-repository
IMAGE_TAG=dev
